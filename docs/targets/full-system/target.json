  "boundaries": [
    {
      "slug": "core-pooltype",
      "name": "Core ↔ Pool Type",
      "abbreviation": "CP",
      "contracts": [
        "lbamm-core/src/modules/AMMModule.sol",
        "amm-pool-type-dynamic/src/DynamicPoolType.sol",
        "lbamm-pool-type-fixed/src/FixedPoolType.sol",
        "lbamm-pool-type-fixed/src/libraries/FixedHelper.sol",
        "lbamm-pool-type-single-provider/src/SingleProviderPoolType.sol"
      ],
      "focus_keywords": ["Rounding direction", "fee math", "unchecked blocks", "downcast truncation", "precision loss"],
      "exploit_patterns": ["EXP-01", "EXP-02", "EXP-03", "EXP-07", "EXP-09", "EXP-10", "EXP-11", "EXP-15"],
      "routing": {
        "primary": ["precision-sniper", "math-deep-diver", "price-distorter", "insolvency-engineer"]
      }
    },
    {
      "slug": "core-handler",
      "name": "Core ↔ Handler",
      "abbreviation": "CH",
      "contracts": [
        "lbamm-core/src/modules/AMMModule.sol",
        "lbamm-hooks-and-handlers/src/handlers/clob/CLOBTransferHandler.sol",
        "lbamm-hooks-and-handlers/src/handlers/permit/PermitTransferHandler.sol",
        "lbamm-hooks-and-handlers/src/hooks/AMMStandardHook.sol"
      ],
      "focus_keywords": ["Settlement conservation", "caller validation", "return value trust"],
      "exploit_patterns": ["EXP-05", "EXP-08", "EXP-09", "EXP-10", "EXP-12", "EXP-13"],
      "routing": {
        "primary": ["auth-forger", "state-desync", "composability-exploiter"]
      }
    },
    {
      "slug": "handler-hook",
      "name": "Handler ↔ Hook",
      "abbreviation": "HH",
      "contracts": [
        "lbamm-hooks-and-handlers/src/handlers/clob/CLOBTransferHandler.sol",
        "lbamm-hooks-and-handlers/src/hooks/AMMStandardHook.sol"
      ],
      "focus_keywords": ["Callback ordering", "reentrancy guards", "state read before call"],
      "exploit_patterns": ["EXP-03", "EXP-04", "EXP-06", "EXP-07", "EXP-08", "EXP-12", "EXP-15"],
      "routing": {
        "primary": ["state-desync", "composability-exploiter", "cross-boundary"]
      }
    },
    {
      "slug": "hook-registry",
      "name": "Hook ↔ Registry",
      "abbreviation": "HR",
      "contracts": [
        "lbamm-hooks-and-handlers/src/hooks/AMMStandardHook.sol",
        "lbamm-hooks-and-handlers/src/hooks/CreatorHookSettingsRegistry.sol"
      ],
      "focus_keywords": ["Cache consistency", "initialization race", "settings atomicity"],
      "exploit_patterns": [],
      "routing": {
        "primary": ["extension-hijacker", "state-desync"]
      }
    },
    {
      "slug": "diamond-proxy",
      "name": "Diamond Proxy",
      "abbreviation": "DP",
      "contracts": [
        "lbamm-core/src/modules/AMMModule.sol",
        "lbamm-core/src/modules/ModuleAdmin.sol",
        "lbamm-core/src/modules/ModuleFeeCollection.sol",
        "lbamm-core/src/modules/ModuleLiquidity.sol"
      ],
      "focus_keywords": ["Interface collisions", "upgrade paths", "delegatecall context", "selector collisions"],
      "exploit_patterns": ["EXP-09", "EXP-13", "EXP-14"],
      "routing": {
        "primary": ["cross-boundary", "extension-hijacker"]
      }
    },
    {
      "slug": "transient-storage",
      "name": "Transient Storage",
      "abbreviation": "TS",
      "contracts": [
        "lbamm-hooks-and-handlers/src/hooks/AMMStandardHook.sol",
        "lbamm-hooks-and-handlers/src/handlers/clob/CLOBTransferHandler.sol"
      ],
      "focus_keywords": ["Slot lifecycle", "cross-operation leaks", "missing clears on revert"],
      "exploit_patterns": ["EXP-04", "EXP-06"],
      "routing": {
        "primary": ["state-desync", "cross-boundary", "composability-exploiter"]
      }
    }
  ],

  "state_coupling_extra_agents": ["state-desync", "insolvency-engineer", "composability-exploiter"],

  "budget": {
    "max_run_cost_usd": 200,
    "max_turns_per_agent": 500,
    "max_hypotheses_per_agent": 10
  },

  "custom_detectors": [
    "docs.orchestrator.custom_detectors.diamond_slot_collision",
    "docs.orchestrator.custom_detectors.hook_reentrancy",
    "docs.orchestrator.custom_detectors.transient_storage_leak",
    "docs.orchestrator.custom_detectors.unchecked_delegatecall_return"
