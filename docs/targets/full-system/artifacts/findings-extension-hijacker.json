  "hypothesis_results": [
    {
      "id": "H-R8-HR-01",
      "status": "tested",
      "detail": "Direct swap pricing bounds check in _validatePricingBounds uses pre-fee input amount (stored in TSTORE during beforeSwap) as denominator. With 10% fee, max bound relaxed by ~5.4%. Test proves: truePrice > maxBound but hookComputedPrice < maxBound. However, gross exchange rate is correct metric for market price bounds; fee is separate tax by same creator. Low severity.",
      "test_file": "lbamm-hooks-and-handlers/test/AuditExtHijackerR8.t.sol"
    },
    {
      "id": "H-R8-HR-02",
      "status": "dismissed",
      "detail": "Cross-token pricing bounds gap is by design. AMM calls BOTH token hooks during pool creation, so both sets of bounds ARE enforced. Gap only exists within single hook instance, not in aggregate.",
      "test_file": "lbamm-hooks-and-handlers/test/AuditExtHijackerR8.t.sol",
      "failure_class": "strategic"
    },
    {
      "id": "H-R8-HR-03",
      "status": "dismissed",
      "detail": "SqrtPriceCalculator overflow protection works correctly. When result exceeds uint160, returns 0. _validatePricingBounds checks for 0 and reverts. N-scaling prevents intermediate overflow.",
      "test_file": "lbamm-hooks-and-handlers/test/AuditExtHijackerR8.t.sol",
      "failure_class": "strategic"
    },
    {
      "id": "H-R8-HR-04",
      "status": "dismissed",
      "detail": "minFeeAmount > maxFeeAmount blocks pool creation. Self-inflicted config error (FP pattern #4). Token creator sets own parameters, no external attack vector. Creator can fix by calling setTokenSettings again.",
      "test_file": "lbamm-hooks-and-handlers/test/AuditExtHijackerR8.t.sol",
      "failure_class": "strategic"
    },
    {
      "id": "H-R8-HR-05",
      "status": "dismissed",
      "detail": "feeBPS > MAX_BPS returns fee > amount. Self-inflicted config error. AMM safely reverts with LBAMM__InsufficientInputForFees, preventing fund loss. No external attack vector.",
      "test_file": "lbamm-hooks-and-handlers/test/AuditExtHijackerR8.t.sol",
      "failure_class": "strategic"
    },
    {
      "id": "H-R8-HR-06",
      "status": "dismissed",
      "detail": "Whitelist desync is documented intentional behavior per CreatorHookSettingsRegistry NatSpec lines 24-29. Token/whitelist admin controls which hooks to sync. Not a vulnerability.",
      "test_file": "lbamm-hooks-and-handlers/test/AuditExtHijackerR8.t.sol",
      "failure_class": "strategic"
    },
    {
      "id": "H-R8-HR-07",
      "status": "dismissed",
      "detail": "RULED OUT by CP-005: setTokenSettings syncs raw calldata (initialized=false), so _getOrFetchTokenSettings always re-fetches from registry. Cache is effectively write-through. Test confirms hook uses registry 10% fee, not cached 5%.",
      "test_file": "lbamm-hooks-and-handlers/test/AuditExtHijackerR8.t.sol",
      "failure_class": "strategic"
    },
    {
      "id": "H-R8-HR-08",
      "status": "tested",
      "detail": "CLOB uses unconditional bounds; pool swaps allow corrective direction. Test confirms asymmetry: pool swap passes but CLOB order reverts for same corrective trade. Intentional design difference, not vulnerability.",
      "test_file": "lbamm-hooks-and-handlers/test/AuditExtHijackerR8.t.sol"
    }
